---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import Certs from '../components/Certs.astro';
import { site, experience, skills } from '../data/site';
const featured = (await getCollection('projects')).filter(p => p.data.featured).sort((a, b) => a.data.order - b.data.order);
const tech=['AWS','Python','Java','C++','SQL','Dart','Git','Vercel','Apps Script','Streamlit','Pandas','Networking'];
---
<Base><div class="wrap">
<div class="hero"><div><p class="hello">Hello, my name is</p><h1 class="name">{site.name}</h1>
<p class="role"><span id="rot" data-w="Cloud developer|Full-stack builder|AWS certified">Cloud developer</span><i class="caret"></i></p>
<p class="lead">Happy anywhere in the stack. I build, deploy and look after things on the web.</p>
<div class="cta"><a class="btn" href="/projects">See my projects</a><a class="btn ghost" href="/Momin-Resume.pdf" download>Download CV</a></div></div>
<div class="pic"><div class="blob"></div><img class="photo" src="/photo.svg" alt={`Portrait of ${site.fullName}`}><span class="ring"></span><span class="chip c1">AWS</span><span class="chip c2">Python</span><span class="chip c3">Vercel</span></div></div>
<div class="mq" aria-hidden="true"><div>{[...tech,...tech].map(t => <span>{t}</span>)}</div></div>
<section id="about"><h2>About</h2><div class="two"><p>{site.about}</p><div><h3>Education</h3><p>B.Tech, Computer Science & Engineering, Amity University Uttar Pradesh, 2023 to 2027. CGPA 8.41.</p></div></div></section>
<section id="work"><h2>Selected projects</h2><div class="grid">{featured.map(p => <ProjectCard p={p} />)}</div><p style="margin-top:1.5rem"><a class="btn ghost" href="/projects">All projects</a></p></section>
<section id="experience"><h2>Experience</h2><div class="tl">{experience.map(e => <div><h3>{e.role}</h3><p class="meta">{e.org}, {e.when}</p><ul>{e.points.map(x => <li>{x}</li>)}</ul></div>)}</div></section>
<section id="skills"><h2>Skills</h2><div class="skills">{skills.map(s => <div><h3>{s.group}</h3><p>{s.items.join(', ')}</p></div>)}</div></section>
<Certs />
<section id="contact" class="contact"><h2>Contact</h2><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.github}>GitHub</a><a href={site.linkedin}>LinkedIn</a></section>
</div></Base>
